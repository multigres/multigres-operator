+package multiadmin
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	metadata "github.com/multigres/multigres/go/pb/clustermetadata"
+)
+
+func TestFindPoolerForBackup_RespectsShard(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		role  metadata.RoutingRole
+		mode  metadata.LeadershipMode
+		force bool
+	}{
+		{"static", metadata.RoutingRole_ROUTING_ROLE_PRIMARY, metadata.LeadershipMode_LEADERSHIP_MODE_STATIC, false},
+		{"static forced", metadata.RoutingRole_ROUTING_ROLE_PRIMARY, metadata.LeadershipMode_LEADERSHIP_MODE_STATIC, true},
+		{"consensus leader", metadata.RoutingRole_ROUTING_ROLE_PRIMARY, metadata.LeadershipMode_LEADERSHIP_MODE_CONSENSUS, true},
+		{"consensus follower", metadata.RoutingRole_ROUTING_ROLE_REPLICA, metadata.LeadershipMode_LEADERSHIP_MODE_CONSENSUS, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			server := newTestServer(t, "cell1")
+			defer server.Stop()
+			other := makeRoutedPooler("cell1", "other", tc.role)
+			other.ShardKey.Shard = "80-inf"
+			other.ServingStatus = metadata.PoolerServingStatus_SERVING
+			other.LeadershipMode = tc.mode
+			require.NoError(t, server.ts.CreateMultipooler(t.Context(), other))
+			_, err := server.findPoolerForBackup(t.Context(), "db1", "default", "0-80", tc.force)
+			require.Error(t, err, "must not operate on another shard's backup repository")
+			target := makeRoutedPooler("cell1", "target", tc.role)
+			target.ShardKey.Shard = "0-80"
+			target.ServingStatus = metadata.PoolerServingStatus_SERVING
+			target.LeadershipMode = tc.mode
+			require.NoError(t, server.ts.CreateMultipooler(t.Context(), target))
+			got, err := server.findPoolerForBackup(t.Context(), "db1", "default", "0-80", tc.force)
+			require.NoError(t, err)
+			require.Equal(t, target.Id.Name, got.Id.Name)
+			require.Equal(t, target.Id.Cell, got.Id.Cell)
+			require.Equal(t, target.Id.Component, got.Id.Component)
+		})
+	}
+}
